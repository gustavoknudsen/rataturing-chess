# Local credentials - never commit
.env

# Virtualenvs
.venv/
.venv_nnue/

# Python
__pycache__/
*.pyc

# Build output. The submission is rebuilt from source by tools/package.py.
submission*.zip

# The network and the books ARE tracked. They are 40 MB together, well inside
# GitHub's limits, and without them a clone silently runs the weaker
# hand-crafted evaluation with no book. They live beside the engine because
# btc_nnue.find_net() and btc_book._path() both resolve relative to their own
# module, and the submission zip is flat.

# Working data at the repo root: generated opening sets, caches. The leading
# slash matters - a bare `data/` would also match book/data/, and git will not
# re-include files inside an excluded directory, so the book's tracked
# reference set would silently vanish.
/data/

# Old champion builds, superseded submissions and backups. Kept on disk for
# diffing against past versions, never in the repo.
archive/


# Training notebooks. Only the notebook that produced the shipped network is
# tracked; the rest are width and data experiments that were not adopted.
training/notebooks/*
!training/notebooks/kaggle_nnue.ipynb

# Compiled helpers for the training data pipeline.
tools/*.exe
tools/*.obj

# Opening-book pipeline data.
#
# The bulk stays out: harvested PGNs, full label tables and source .bin books
# come to roughly 1.3 GB. A small reference set IS tracked, because it is what
# shows the book's provenance - which positions it had to answer, and a sample
# of our own engine labelling of them.
#
# engines/ and books/ hold binaries and source books. They are ignored, so
# they do not appear in the repository at all; book/data/README.txt says what
# belongs in them.
book/data/*
!book/data/README.txt
!book/data/start_fens.txt
!book/data/starts_clean.txt
!book/data/starts_deep.txt
!book/data/candidates16.tsv
!book/data/conflicts.tsv
!book/data/need_candidates_ordered.txt
!book/data/labels.tsv
!book/data/labels_d30.tsv
!book/data/hedge_tolabel.txt
!book/data/round1.txt

# UCI release build output: staging trees, frozen executables and the
# archives. All of it is reproducible from submission.zip by uci/build.py,
# and the archives are attached to a GitHub release rather than committed.
release/
*.spec

staged/staging/

# Working notes for the next session, not part of the published repository.
HANDOFF.md

# Editor and assistant state, patch leftovers.
.claude/
*.orig
*.rej
